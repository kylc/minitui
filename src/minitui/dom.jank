(ns minitui.dom
  (:refer-clojure :exclude [empty])
  (:require [minitui.util :refer [make-el unbox-el]])
  (:include "ftxui/dom/elements.hpp"))

;; Widgets

(defn text [text]
  (make-el (cpp/ftxui.text text)))

(defn vtext [text]
  (make-el (cpp/ftxui.vtext text)))

(defn separator []
  (make-el (cpp/ftxui.separator)))

(defn gauge [ratio]
  (make-el (cpp/ftxui.gauge ratio)))

(defn border [el]
  (make-el (cpp/ftxui.border (unbox-el el))))

(defn window [title content]
  (make-el (cpp/ftxui.window (unbox-el title) (unbox-el content))))

;; TODO: spinner

(defn paragraph [text]
  (make-el (cpp/ftxui.paragraph text)))

(cpp/raw "
#include <jank/runtime/sequence_range.hpp>

namespace minitui::dom {
inline std::function<std::vector<int>(int, int)>
wrap_graph(jank::runtime::object_ref f) {
  return [=](int width, int height) {
    auto out = f.call(jank::runtime::make_box(width),
                      jank::runtime::make_box(height));
    auto seq = make_sequence_range(out);
    std::vector<int> output;
    for (auto y : seq) {
      output.push_back(y.to_integer());
    }
    return output;
  };
}
}
")

(defn graph [f]
  (make-el (cpp/ftxui.graph (cpp/minitui.dom.wrap_graph f))))

(defn empty []
  (make-el (cpp/ftxui.emptyElement)))

