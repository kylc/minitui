(ns minitui.dom
  (:refer-clojure :exclude [empty])
  (:require [minitui.util :as util :refer [make-el unbox-el]])
  (:include "ftxui/dom/elements.hpp"))

;; Widgets

(defn text [text]
  (make-el (cpp/ftxui.text text)))

(defn vtext [text]
  (make-el (cpp/ftxui.vtext text)))

(defn separator
  ([] (make-el (cpp/ftxui.separator)))
  ([style-or-char]
   (if (keyword? style-or-char)
     (make-el (cpp/ftxui.separatorStyled (util/border-style style-or-char)))
     (make-el (cpp/ftxui.separatorCharacter style-or-char)))))

(defn gauge
  ([ratio] (make-el (cpp/ftxui.gauge ratio)))
  ([ratio direction]
   (make-el (cpp/ftxui.gaugeDirection ratio (util/direction direction)))))

(defn border
  ([el] (make-el (cpp/ftxui.border (unbox-el el))))
  ([el style]
   (make-el (cpp/| (unbox-el el) (cpp/ftxui.borderStyled (util/border-style style)))))
  ([el style color]
   (let [c (cpp/unbox (:* cpp/ftxui.Color) color)]
     (make-el (cpp/| (unbox-el el) (cpp/ftxui.borderStyled (util/border-style style) (cpp/* c)))))))

(defn window [title content]
  (make-el (cpp/ftxui.window (unbox-el title) (unbox-el content))))

;; TODO: spinner

(defn paragraph
  ([text] (make-el (cpp/ftxui.paragraph text)))
  ([text align]
   (case align
     :left    (make-el (cpp/ftxui.paragraphAlignLeft text))
     :right   (make-el (cpp/ftxui.paragraphAlignRight text))
     :center  (make-el (cpp/ftxui.paragraphAlignCenter text))
     :justify (make-el (cpp/ftxui.paragraphAlignJustify text)))))

(cpp/raw "
#include <jank/runtime/sequence_range.hpp>

namespace minitui::dom {
inline std::function<std::vector<int>(int, int)>
wrap_graph(jank::runtime::object_ref f) {
  return [=](int width, int height) {
    auto out = f.call(jank::runtime::make_box(width),
                      jank::runtime::make_box(height));
    std::vector<int> output;
    for (auto y : make_sequence_range(out)) {
      output.push_back(y.to_integer());
    }
    return output;
  };
}
}
")

(defn graph [f]
  (make-el (cpp/ftxui.graph (cpp/minitui.dom.wrap_graph f))))

(defn empty []
  (make-el (cpp/ftxui.emptyElement)))

;; TODO: canvas

;; Decorators

(defn bold [el]
  (make-el (cpp/ftxui.bold (unbox-el el))))

(defn dim [el]
  (make-el (cpp/ftxui.dim (unbox-el el))))

;; TODO
;; (defn italic [el]
;;   (make-el (cpp/ftxui.italic (unbox-el el))))

(defn inverted [el]
  (make-el (cpp/ftxui.inverted (unbox-el el))))

(defn underlined [el]
  (make-el (cpp/ftxui.underlined (unbox-el el))))

(defn underlined-double [el]
  (make-el (cpp/ftxui.underlinedDouble (unbox-el el))))

(defn blink [el]
  (make-el (cpp/ftxui.blink (unbox-el el))))

(defn strikethrough [el]
  (make-el (cpp/ftxui.strikethrough (unbox-el el))))

;; TODO: Color constructors, palettes

(defn color [color el]
  (let [c (cpp/ftxui.Color (cpp/* (cpp/unbox (:* cpp/ftxui.Color) color)))]
    (make-el (cpp/ftxui.color c (unbox-el el)))))

(defn bgcolor [color el]
  (let [c (cpp/ftxui.Color (cpp/* (cpp/unbox (:* cpp/ftxui.Color) color)))]
    (make-el (cpp/ftxui.bgcolor c (unbox-el el)))))

;; TODO: gradients

(defn hyperlink [link el]
  (make-el (cpp/ftxui.hyperlink link (unbox-el el))))

;; Layout

(defn hbox [& els]
  (let [els' (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els' (unbox-el el)))
    (make-el (cpp/ftxui.hbox els'))))

(defn vbox [& els]
  (let [els' (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els' (unbox-el el)))
    (make-el (cpp/ftxui.vbox els'))))

(defn dbox [& els]
  (let [els' (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els' (unbox-el el)))
    (make-el (cpp/ftxui.dbox els'))))

(defn flexbox [config & els]
  (let [config  (cpp/* (cpp/unbox (:* cpp/ftxui.FlexboxConfig) (util/flexbox-config config)))
        els-vec (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els-vec (unbox-el el)))
    (make-el (cpp/ftxui.flexbox els-vec config))))

(defn gridbox [& lines]
  (let [lines-vec (#cpp (cpp/std.vector cpp/ftxui.Elements))]
    (doseq [line lines]
      (let [elements-vec (#cpp (cpp/std.vector cpp/ftxui.Element))]
        (doseq [el line]
          (.push_back elements-vec (unbox-el el)))
        (.push_back lines-vec elements-vec)))
    (make-el (cpp/ftxui.gridbox lines-vec))))

