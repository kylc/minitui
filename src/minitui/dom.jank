(ns minitui.dom
  (:refer-clojure :exclude [empty])
  (:require [minitui.util :as util])
  (:include "ftxui/dom/elements.hpp" "minitui/support.hpp"))

;; Widgets

(defn text
  "Draw a single line of text, oriented horizontally."
  [text]
  (cpp/ftxui.text text))

(defn vtext
  "Draw a single line of text, oriented vertically."
  [text]
  (cpp/ftxui.vtext text))

(defn separator
  "Draw a vertical or horizontal separator between two elements. The direction
  is automatic based on the flow of the parent container.

  If style-or-char is a character, then that will be repeated to form the
  separator. Otherwise it is one of :light, :dashed, :heavy, :double, :rounded,
  or :empty."
  ([] (cpp/ftxui.separator))
  ([style-or-char]
   (if (keyword? style-or-char)
     (cpp/ftxui.separatorStyled (util/border-style style-or-char))
     (cpp/ftxui.separatorCharacter style-or-char))))

(defn gauge
  "An element drawing a progress bar. The ratio is given in the range [0, 1].

  If direction is specified, it is one of :up, :down, :left, :right. The
  progress bar fills from this direction."
  ([ratio] (cpp/ftxui.gauge ratio))
  ([ratio direction]
   (cpp/ftxui.gaugeDirection ratio (util/direction direction))))

(defn border
  "An element drawing a border around its content.

  If specified, style is one of :light, :dashed, :heavy, :double, :rounded, or
  :empty."
  ([el] (cpp/ftxui.border el))
  ([el style]
   (cpp/| (cpp/cast cpp/ftxui.Element el)
          (cpp/ftxui.borderStyled (util/border-style style))))
  ([el style color]
   (let [c (cpp/unbox (:* cpp/ftxui.Color) color)]
     (cpp/| (cpp/cast cpp/ftxui.Element el)
            (cpp/ftxui.borderStyled (util/border-style style) (cpp/* c))))))

(defn window
  "An element which draws a border around its content and renders the `title`
  element at the top."
  [title content]
  (cpp/ftxui.window title content))

;; TODO: spinner

(defn paragraph
  "An element drawing multiple lines of text with optional alignment.

  If align is specified, it is one of :left, :right, :center, or :justify."
  ([text] (cpp/ftxui.paragraph text))
  ([text align]
   (case align
     :left    (cpp/ftxui.paragraphAlignLeft text)
     :right   (cpp/ftxui.paragraphAlignRight text)
     :center  (cpp/ftxui.paragraphAlignCenter text)
     :justify (cpp/ftxui.paragraphAlignJustify text))))

(defn graph
  "Draws an area chart of the given function.

  The function f accepts two arguments for the integer width and height of the
  graph. It should return a sequence of integer y coordinates in the range [0,
  height]."
  [f]
  (cpp/ftxui.graph (cpp/minitui.wrap_graph f)))

(defn empty
  "An empty placeholder element."
  []
  (cpp/ftxui.emptyElement))

;; TODO: canvas

;; Decorators

(defn bold
  "Emphasize the content."
  [el]
  (cpp/ftxui.bold el))

(defn dim
  "De-emphasize the content."
  [el]
  (cpp/ftxui.dim el))

;; TODO: this doesn't exist in the version of minitui distributed with
;; jank
;; (defn italic [el]
;;   (cpp/ftxui.italic el))

(defn inverted
  "Draws the contents with inverted foreground and background colors."
  [el]
  (cpp/ftxui.inverted el))

(defn underlined
  "Underline the contents."
  [el]
  (cpp/ftxui.underlined el))

(defn underlined-double
  "Double underline the contents."
  [el]
  (cpp/ftxui.underlinedDouble el))

(defn blink
  "Draw the contents with automatically toggling visibility."
  [el]
  (cpp/ftxui.blink el))

(defn strikethrough
  "Draw the contents with strikethrough."
  [el]
  (cpp/ftxui.strikethrough el))

;; TODO: Color constructors, palettes

(defn color
  "Draw the contents with the given foreground color."
  [color el]
  (let [c (cpp/ftxui.Color (cpp/* (cpp/unbox (:* cpp/ftxui.Color) color)))]
    (cpp/ftxui.color c (cpp/cast cpp/ftxui.Element el))))

(defn bgcolor
  "Draw the contents with the given background color."
  [color el]
  (let [c (cpp/ftxui.Color (cpp/* (cpp/unbox (:* cpp/ftxui.Color) color)))]
    (cpp/ftxui.bgcolor c (cpp/cast cpp/ftxui.Element el))))

;; TODO: gradients

(defn hyperlink
  "Make the contents clickable to open the given link."
  [link el]
  (cpp/ftxui.hyperlink link el))

;; Layout

(defn hbox
  "A layout container which displays its elements horizontally one by one."
  [& els]
  (let [els' (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els' (cpp/cast cpp/ftxui.Element el)))
    (cpp/ftxui.hbox els')))

(defn vbox
  "A layout container which displays its elements vertically one by one."
  [& els]
  (let [els' (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els' (cpp/cast cpp/ftxui.Element el)))
    (cpp/ftxui.vbox els')))

(defn dbox
  "A layout container which displays its contents stacked on top of each other."
  [& els]
  (let [els' (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els' (cpp/cast cpp/ftxui.Element el)))
    (cpp/ftxui.dbox els')))

(defn flexbox
  "A layout container which displays its elements according to flexbox rules.

  The config may contain:
    - :direction - The main axis. One of :row, :row-inversed, :column,
                   :column-inversed.
    - :wrap - Whether flex items are forced to wrap when space runs out.
              One of :no-wrap, :wrap, :wrap-inversed.
    - :justify-content - How items are distributed along the main axis. One of
                         :flex-start, :flex-end, :center, :stretch,
                         :space-between, :space-around, or :space-evenly.
    - :align-items - How items are aligned along the cross axis on the current
                     line. One of :flex-start, :flex-end, :center, or :stretch.
    - :align-content - How lines are distributed along the cross axis when
                       extra space is available. One of :flex-start, :flex-end,
                       :center, :stretch, :space-between, :space-around, or
                       :space-evenly."
  [config & els]
  (let [config  (cpp/* (cpp/unbox (:* cpp/ftxui.FlexboxConfig) (util/flexbox-config config)))
        els-vec (#cpp (cpp/std.vector cpp/ftxui.Element))]
    (doseq [el els]
      (.push_back els-vec (cpp/cast cpp/ftxui.Element el)))
    (cpp/ftxui.flexbox els-vec config)))

(defn gridbox
  "A container displaying a grid of elements.

  Each argument is a line (row), which is itself a sequence of elements."
  [& lines]
  (let [lines-vec (#cpp (cpp/std.vector cpp/ftxui.Elements))]
    (doseq [line lines]
      (let [elements-vec (#cpp (cpp/std.vector cpp/ftxui.Element))]
        (doseq [el line]
          (.push_back elements-vec (cpp/cast cpp/ftxui.Element el)))
        (.push_back lines-vec elements-vec)))
    (cpp/ftxui.gridbox lines-vec)))

;; Flexibility

(defn flex
  "Make a child element expand proportionally to the space left in a container."
  [el]
  (cpp/ftxui.flex el))

(defn flex-grow
  "Expand if possible."
  [el]
  (cpp/ftxui.flex_grow el))

(defn flex-shrink
  "Minimize if needed."
  [el]
  (cpp/ftxui.flex_shrink el))

(defn xflex
  "Expand/minimize if possible/needed on the X axis."
  [el]
  (cpp/ftxui.xflex el))

(defn xflex-grow
  "Expand if possible on the X axis."
  [el]
  (cpp/ftxui.xflex_grow el))

(defn xflex-shrink
  "Minimize if needed on the X axis."
  [el]
  (cpp/ftxui.xflex_shrink el))

(defn yflex
  "Expand/minimize if possible/needed on the Y axis."
  [el]
  (cpp/ftxui.yflex el))

(defn yflex-grow
  "Expand if possible on the Y axis."
  [el]
  (cpp/ftxui.yflex_grow el))

(defn yflex-shrink
  "Minimize if needed on the Y axis."
  [el]
  (cpp/ftxui.yflex_shrink el))

(defn notflex
  "Reset the flex attribute, making the element not flexible."
  [el]
  (cpp/ftxui.notflex el))

(defn filler
  "A blank element that expands proportionally to fill remaining space in a
  container."
  []
  (cpp/ftxui.filler))

;; Util

(defn hcenter
  "Center an element horizontally."
  [el]
  (cpp/ftxui.hcenter el))

(defn vcenter
  "Center an element vertically."
  [el]
  (cpp/ftxui.vcenter el))

(defn center
  "Center an element horizontally and vertically."
  [el]
  (cpp/ftxui.center el))

(defn align-right
  "Align an element to the right side."
  [el]
  (cpp/ftxui.align_right el))

(defn nothing
  "A decoration that does nothing."
  [el]
  (cpp/ftxui.nothing el))
