(ns minitui.screen
  (:refer-clojure :exclude [print])
  (:require [minitui.util :refer [unbox-el]])
  (:include "ftxui/screen/screen.hpp"))

(defn fit [el]
  (let [d (cpp/ftxui.Dimension.Fit (unbox-el el))]
    (cpp/box (cpp/new cpp/ftxui.Dimensions d))))

(defn fixed [x]
  (let [d (cpp/ftxui.Dimension.Fixed (cpp/int x))]
    (cpp/box (cpp/new cpp/ftxui.Dimensions d))))

(defn full []
  (let [d (cpp/ftxui.Dimension.Full)]
    (cpp/box (cpp/new cpp/ftxui.Dimensions d))))

(defn create
  ([dim] (create dim dim))
  ([w h]
   (let [screen (cpp/ftxui.Screen.Create
                 (cpp/* (cpp/unbox (:* cpp/ftxui.Dimensions) w))
                 (cpp/* (cpp/unbox (:* cpp/ftxui.Dimensions) h)))]
     (cpp/box (cpp/new cpp/ftxui.Screen screen)))))

(defn render
  "Mutate the screen internal state by rendering the contents of the given
  element."
  [screen el]
  (let [screen (cpp/* (cpp/unbox (:* cpp/ftxui.Screen) screen))]
    (cpp/ftxui.Render screen el)))

(defn print
  "Print the screen contents (after render!) to the terminal."
  [screen]
  (let [screen (cpp/* (cpp/unbox (:* cpp/ftxui.Screen) screen))]
    (.Print screen)))

(defn clear [screen]
  (let [screen (cpp/* (cpp/unbox (:* cpp/ftxui.Screen) screen))]
    (.Clear screen)))

(defn to-string
  "Like `print` but return the screen contents as a string."
  [screen]
  (let [screen (cpp/* (cpp/unbox (:* cpp/ftxui.Screen) screen))]
    (.ToString screen)))

(defn reset-position
  "Returns a string that, when printed, will move the the cursor position back
  to the beginning of the screen."
  [screen]
  (let [screen (cpp/* (cpp/unbox (:* cpp/ftxui.Screen) screen))]
    (.ResetPosition screen)))
